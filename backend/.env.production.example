# Copy to .env.production and fill in. Never commit the real file.
POSTGRES_PASSWORD=change-me-long-random
# Public https URL of this API, including /api/v1 (also what you set as NEXT_PUBLIC_API_URL on Vercel)
API_PUBLIC_URL=https://api.example.com/api/v1
# The website origin(s) allowed to call the API, comma separated
FRONTEND_ORIGINS=https://safety-gps-tracker.vercel.app
# Long random string:  openssl rand -base64 48
JWT_SECRET=change-me
# First admin, created once when the database is empty. Use a strong password, not the development one.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong-8-to-72-chars
# API_PORT=4000
